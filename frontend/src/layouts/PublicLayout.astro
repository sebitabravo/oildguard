---
import "../theme.css";
// Solo español (S03): la raíz sirve español; el valor por defecto es español
// porque S01 retiró el idioma por consulta y la ruta /es/ se descartó.
const { title = "OilGuard Mining", lang = "es" } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title></head><body><main class="og-content" style="margin-left:0"><slot /></main></body></html>
