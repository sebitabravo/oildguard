---
import "../theme.css";
import { t, type DictKey } from "../i18n";
import type { Section } from "../routes";

interface Props {
  section: Section;
}

const { section } = Astro.props;
const navigation: Array<{ id: Section; label: DictKey; href: string }> = [
  { id: "mine", label: "nav.mine", href: "/mine" },
  { id: "wheel", label: "nav.wheel", href: "/wheel" },
  { id: "monitoring", label: "nav.monitoring", href: "/monitoring" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23f2b705'/%3E%3C/svg%3E" />
    <title>OilGuard Mining — Digital twin</title>
    <script is:inline>
      document.documentElement.style.visibility = "hidden";
      const queryLanguage = new URLSearchParams(window.location.search).get("lang")?.trim().toLowerCase();
      try {
        if (queryLanguage === "en" || queryLanguage === "es") {
          localStorage.setItem("oilguard-lang", queryLanguage);
        }
        document.documentElement.lang =
          queryLanguage === "es" || (queryLanguage !== "en" && localStorage.getItem("oilguard-lang") === "es")
            ? "es"
            : "en";
      } catch {
        document.documentElement.lang = queryLanguage === "es" ? "es" : "en";
      }
    </script>
  </head>
  <body>
    <div class="og-app">
      <header class="og-top">
        <div class="og-brand">
          <div class="og-brand__mark" aria-hidden="true">OG</div>
          <div>
            <div class="og-brand__name" data-i18n-en={t("app.brand", "en")} data-i18n-es={t("app.brand", "es")}>{t("app.brand", "en")}</div>
            <div class="og-brand__tag" data-i18n-en={t("app.tagline", "en")} data-i18n-es={t("app.tagline", "es")}>{t("app.tagline", "en")}</div>
          </div>
        </div>
        <nav class="og-nav" aria-label={t("nav.label", "en")} data-i18n-aria-en={t("nav.label", "en")} data-i18n-aria-es={t("nav.label", "es")}>
          {navigation.map((item) => (
            <a
              class="og-nav__item"
              href={item.href}
              aria-current={section === item.id ? "page" : undefined}
              data-i18n-en={t(item.label, "en")}
              data-i18n-es={t(item.label, "es")}
            >
              {t(item.label, "en")}
            </a>
          ))}
        </nav>
        <div class="og-top__spacer"></div>
        <div class="og-seg" role="group" aria-label={t("lang.label", "en")} data-i18n-aria-en={t("lang.label", "en")} data-i18n-aria-es={t("lang.label", "es")}>
          <button type="button" class="og-seg__btn" data-lang="en" aria-pressed="true">EN</button>
          <button type="button" class="og-seg__btn" data-lang="es" aria-pressed="false">ES</button>
        </div>
      </header>
      <script is:inline>
        const language = document.documentElement.lang === "es" ? "es" : "en";
        document.querySelectorAll("[data-i18n-en]").forEach((element) => {
          element.textContent = element.dataset[language === "en" ? "i18nEn" : "i18nEs"] ?? "";
        });
        document.querySelectorAll("[data-i18n-aria-en]").forEach((element) => {
          element.setAttribute("aria-label", element.dataset[language === "en" ? "i18nAriaEn" : "i18nAriaEs"] ?? "");
        });
        document.querySelectorAll("[data-lang]").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.lang === language));
        });
        document.documentElement.style.visibility = "";
      </script>
      <main class="og-content"><slot /></main>
    </div>
    <script>
      import { isLegacyHash, pathFromHash } from "../routes";
      import { languageFromQuery } from "../i18n/queryLanguage";

      const languageKey = "oilguard-lang";
      const readLanguage = () => {
        try {
          return localStorage.getItem(languageKey) === "es" ? "es" : "en";
        } catch {
          return "en";
        }
      };

      const updateLanguage = (language: "en" | "es") => {
        document.documentElement.lang = language;
        document.querySelectorAll<HTMLElement>("[data-i18n-en]").forEach((element) => {
          element.textContent = element.dataset[`i18n${language === "en" ? "En" : "Es"}`] ?? "";
        });
        document.querySelectorAll<HTMLElement>("[data-i18n-aria-en]").forEach((element) => {
          element.setAttribute(
            "aria-label",
            element.dataset[`i18nAria${language === "en" ? "En" : "Es"}`] ?? "",
          );
        });
        document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.lang === language));
        });
      };

      document.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((button) => {
        button.addEventListener("click", () => {
          const language = button.dataset.lang === "es" ? "es" : "en";
          try {
            localStorage.setItem(languageKey, language);
          } catch {
            // El almacenamiento puede no estar disponible en algunos contextos.
          }
          window.dispatchEvent(new CustomEvent("oilguard:lang", { detail: language }));
        });
      });

      window.addEventListener("oilguard:lang", (event) => {
        const language = (event as CustomEvent<unknown>).detail;
        if (language === "en" || language === "es") updateLanguage(language);
      });
      window.addEventListener("storage", (event) => {
        if (event.key === languageKey) updateLanguage(readLanguage());
      });
      const queryLanguage = languageFromQuery(window.location.search);
      if (queryLanguage) {
        try {
          localStorage.setItem(languageKey, queryLanguage);
        } catch {
          // El almacenamiento puede no estar disponible en algunos contextos.
        }
        window.dispatchEvent(new CustomEvent("oilguard:lang", { detail: queryLanguage }));
      }
      updateLanguage(queryLanguage ?? readLanguage());

      const redirectLegacyHash = () => {
        if (!isLegacyHash(window.location.hash)) return;
        const target = pathFromHash(window.location.hash, window.location.search);
        if (`${window.location.pathname}${window.location.search}` !== target) {
          window.location.replace(target);
          return;
        }
        window.history.replaceState(null, "", target);
      };

      redirectLegacyHash();
      window.addEventListener("hashchange", redirectLegacyHash);
    </script>
  </body>
</html>
