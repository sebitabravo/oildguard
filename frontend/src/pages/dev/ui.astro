---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UiCatalogue from "../../ui/UiCatalogue";
---
<BaseLayout title="OilGuard · UI foundation">
  <div class="dev-ui-page">
    <UiCatalogue client:load />
  </div>
</BaseLayout>

<style is:global>
  .dev-ui-page { min-width: 0; max-width: 100%; }
  .dev-ui-page .og-notice { display: block; min-width: 0; overflow-wrap: anywhere; }
  .dev-ui-page .og-alert-banner { flex-wrap: wrap; min-width: 0; overflow-wrap: anywhere; }
  .dev-ui-page .og-alert-banner > span { min-width: 0; overflow-wrap: anywhere; }
  .dev-ui-page .og-alert-actions { flex-wrap: wrap; min-width: 0; margin-left: 0; }
</style>
